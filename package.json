{
  "name": "nvp",
  "version": "1.0.0-rc.1",
  "description": "Music Releases Notifier",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node ./dist/index.js",
    "start:watch": "nodemon ./dist/index.js",
    "build:clear": "rm -rf dist",
    "build": "npm run build:clear && tsc",
    "build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "postbuild": "tsc-alias && npm run lint",
    "lint": "eslint -- ./src"
  },
  "license": "MIT",
  "author": {
    "name": "misbiheyv",
    "email": "mishagorkovenko1103@gmail.com"
  },
  "dependencies": {
    "cron": "^4.3.1",
    "dotenv": "^16.5.0",
    "telegraf": "^4.16.3",
    "vk-io": "^4.9.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^9.29.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@types/node": "^24.0.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
