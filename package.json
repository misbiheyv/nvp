{
  "name": "nvp",
  "version": "1.0.0-rc.1",
  "description": "Music Releases Notifier",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "ENVIRONMENT=DEV node ./dist/index.js",
    "start": "ENVIRONMENT=PROD node ./dist/index.js",
    "dev:watch": "nodemon ./dist/index.js",

    "build:clear": "rm -rf dist",
    "build": "npm run build:clear && tsc",
    "build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",

    "postbuild": "tsc-alias && npm run lint",
    "lint": "eslint -- ./src"
  },
  "license": "MIT",
  "author": {
    "name": "misbiheyv",
    "email": "mishagorkovenko1103@gmail.com"
  },
  "dependencies": {
    "cron": "^2.4.3",
    "dotenv": "^16.3.1",
    "telegraf": "^4.12.2",
    "vk-io": "^4.8.1",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^18.14.6",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.47.0",
    "nodemon": "^3.1.0",
    "tsc-alias": "^1.8.7",
    "tslib": "^2.6.2",
    "typescript": "^4.9.5"
  }
}
